{
  "name": "zeno-editor",
  "version": "1.0.0",
  "description": "Zeno Editor - AI powered mobile code editor (Capacitor 6 + Ionic Angular + Monaco)",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "sync": "npm run build && npx cap sync android",
    "android": "npm run sync && npx cap open android",
    "setup:android": "bash scripts/setup-android.sh"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/splash-screen": "^6.0.2",
    "@ionic/angular": "^8.3.0",
    "ionicons": "^7.4.0",
    "monaco-editor": "^0.52.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@capacitor/cli": "^6.1.2",
    "typescript": "~5.5.4"
  }
}
